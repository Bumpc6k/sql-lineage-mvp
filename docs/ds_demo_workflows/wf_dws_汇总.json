    {
      "id": 122,
      "code": 184722470991426,
      "name": "t_dws_税利汇总",
      "version": 1,
      "description": "税利汇总",
      "projectCode": 184722470975040,
      "userId": 1,
      "taskType": "SQL",
      "taskParams": {
        "localParams": [],
        "resourceList": [],
        "type": "HIVE",
        "datasource": 1,
        "sql": "-- DWS 汇总：按厂 / 牌号 / 月份聚合税利，并算单箱税利\nINSERT OVERWRITE TABLE cdw.dws_税利汇总 PARTITION (dt = '2026-01-01')\nSELECT\n    t.plant_code                           AS plant_code,\n    t.brand_code                           AS brand_code,\n    t.stat_month                           AS stat_month,\n    SUM(t.tax_amt)                         AS total_tax_amt,\n    SUM(t.profit_amt)                      AS total_profit_amt,\n    SUM(t.total_tax_profit)                AS total_tax_profit,\n    MAX(p.total_output_qty)                AS total_output_qty,\n    CASE WHEN MAX(p.total_output_qty) > 0\n         THEN ROUND(SUM(t.total_tax_profit) / MAX(p.total_output_qty), 2)\n         ELSE 0 END                        AS tax_profit_per_box\nFROM cdw.dwd_税利明细 t\nLEFT JOIN cdw.dws_产量汇总 p\n       ON t.plant_code = p.plant_code AND t.brand_code = p.brand_code\nWHERE t.dt = '2026-01-01'\nGROUP BY t.plant_code, t.brand_code, t.stat_month;\n",
        "sqlType": "1",
        "preStatements": [],
        "postStatements": [],
        "displayRows": 10
      },
      "taskParamList": [],
      "taskParamMap": null,
      "flag": "YES",
