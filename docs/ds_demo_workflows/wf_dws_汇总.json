      "code": 184722470991424,
      "name": "t_dws_产量汇总",
      "version": 1,
      "description": "产量汇总",
      "projectCode": 184722470975040,
      "userId": 1,
      "taskType": "SQL",
      "taskParams": {
        "localParams": [],
        "resourceList": [],
        "type": "HIVE",
        "datasource": 1,
        "sql": "-- DWS 汇总：按厂 / 牌号聚合产量\nINSERT OVERWRITE TABLE cdw.dws_产量汇总 PARTITION (dt = '2026-01-01')\nSELECT\n    d.plant_code                           AS plant_code,\n    d.brand_code                           AS brand_code,\n    SUM(d.output_qty)                      AS total_output_qty,\n    SUM(d.defect_qty)                      AS total_defect_qty,\n    COUNT(1)                               AS work_order_cnt\nFROM cdw.dwd_卷烟产量明细 d\nWHERE d.dt = '2026-01-01'\nGROUP BY d.plant_code, d.brand_code;\n",
        "sqlType": "1",
        "preStatements": [],
        "postStatements": [],
        "displayRows": 10
      },
